{
  "mcpServers": {
    "trio": {
      "type": "http",
      "url": "https://mcp.trio.com.br/mcp",
      "default_tools_approval_mode": "prompt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["mcp:foundation"]
          }
        }
      }
    }
  }
}
