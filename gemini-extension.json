{
  "name": "trio",
  "version": "0.1.0",
  "description": "Read balances, statements, Pix payments, receivables and corporate cards from your Trio account directly from Gemini CLI",
  "mcpServers": {
    "trio": {
      "httpUrl": "https://mcp.trio.com.br/mcp"
    }
  },
  "contextFileName": "GEMINI.md",
  "settings": [
    {
      "name": "Trio MCP URL",
      "description": "Trio MCP endpoint URL (default: https://mcp.trio.com.br/mcp).",
      "envVar": "TRIO_MCP_URL"
    }
  ]
}
